# Sahni Tata - Environment Variables Template
# Copy this file to .env and fill in your actual values

# AUTHENTICATION & SECURITY
JWT_SECRET=your-jwt-secret-key-here-generate-random-32-bytes
NODE_ENV=production

# AWS S3 STORAGE
AWS_BUCKET_NAME=tata-storagebucket
AWS_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_CLOUDFRONT_DOMAIN=https://dh0blbvvlqdiy.cloudfront.net

# AWS RDS DATABASE
AWS_RDS_HOST=database-1.cfeiaikgk6qo.ap-south-1.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DBNAME=sahanidatabase
AWS_RDS_USERNAME=postgres
AWS_RDS_PASSWORD=your-rds-database-password-here

# EMAIL CONFIGURATION (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password-here
ADMIN_EMAIL=admin@yourcompany.com

# FRONTEND URL (Optional)
FRONTEND_URL=https://sahni-tata.vercel.app

# DEBUG (Optional)
# DEBUG_DB=true
